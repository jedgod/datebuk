listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
realm=turn.datebuk.example
server-name=turn.datebuk.example
stale-nonce=600
no-loopback-peers
no-multicast-peers
no-cli
total-quota=1200
user-quota=12
max-bps=0
simple-log
log-file=stdout

# Production public/private mapping:
# external-ip=PUBLIC_IP/PRIVATE_IP

# TLS:
# cert=/etc/letsencrypt/live/turn.datebuk.example/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.datebuk.example/privkey.pem

# Recommended relay range; expose it in your firewall:
min-port=49160
max-port=49200
