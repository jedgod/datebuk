listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}
realm=${TURN_DOMAIN}
server-name=${TURN_DOMAIN}
stale-nonce=600
no-loopback-peers
no-multicast-peers
no-cli
total-quota=1600
user-quota=16
min-port=49160
max-port=49250
cert=/etc/letsencrypt/live/${TURN_DOMAIN}/fullchain.pem
pkey=/etc/letsencrypt/live/${TURN_DOMAIN}/privkey.pem
simple-log
log-file=stdout
