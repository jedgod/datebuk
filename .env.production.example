NODE_ENV=production
PORT=4000
SIGNALING_PORT=4001
API_URL=https://api.datebuk.example
SIGNALING_URL=https://signal.datebuk.example
WEB_URL=https://datebuk.example
ALLOWED_ORIGINS=https://datebuk.example,https://admin.datebuk.example
DATABASE_URL=postgresql://datebuk:CHANGE_ME@postgres:5432/datebuk?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET_FILE=/run/secrets/jwt_secret
REFRESH_TOKEN_PEPPER_FILE=/run/secrets/refresh_token_pepper
TOTP_ENCRYPTION_KEY_FILE=/run/secrets/totp_encryption_key
APNS_KEY_PATH=/run/secrets/apple_apns_key
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.datebuk.app
APNS_PRODUCTION=true
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_service_account
TURN_DOMAIN=turn.datebuk.example
TURN_URL=turn:turn.datebuk.example:3478?transport=udp,turn:turn.datebuk.example:3478?transport=tcp,turns:turn.datebuk.example:5349?transport=tcp
TURN_SHARED_SECRET_FILE=/run/secrets/turn_shared_secret
TURN_CREDENTIAL_TTL_SECONDS=600
S3_REGION=us-east-1
S3_BUCKET=datebuk-private-media
# Prefer an IAM task/instance role. For local production simulation only:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
CERTBOT_EMAIL=admin@datebuk.example
TURN_CERT_PATH=/etc/letsencrypt/live/turn.datebuk.example/fullchain.pem
TURN_PRIVATE_KEY_PATH=/etc/letsencrypt/live/turn.datebuk.example/privkey.pem
ANDROID_KEYSTORE_PATH=/run/secrets/android_release_keystore
ANDROID_KEYSTORE_PASSWORD_FILE=/run/secrets/android_keystore_password
ANDROID_KEY_ALIAS=datebuk
ANDROID_KEY_PASSWORD_FILE=/run/secrets/android_key_password
