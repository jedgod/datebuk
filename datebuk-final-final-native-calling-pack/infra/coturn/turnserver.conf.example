listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=REPLACE_WITH_LONG_RANDOM_SECRET
realm=turn.datebuk.example
server-name=turn.datebuk.example
stale-nonce=600
no-loopback-peers
no-multicast-peers
no-cli
total-quota=1600
user-quota=16
min-port=49160
max-port=49250
simple-log
log-file=stdout

# Production:
# external-ip=PUBLIC_IP/PRIVATE_IP
# cert=/etc/letsencrypt/live/turn.datebuk.example/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.datebuk.example/privkey.pem
