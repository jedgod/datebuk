generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum DeviceTokenType {
  APNS_VOIP
  FCM
  WEB_PUSH
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  CREATED
  RINGING
  ACCEPTED
  REJECTED
  CANCELLED
  MISSED
  ENDED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  INVALID_TOKEN
}

model User {
  id              String        @id
  displayName     String
  devices         Device[]
  initiatedCalls  CallSession[] @relation("Caller")
  receivedCalls   CallSession[] @relation("Callee")
  blocksMade      UserBlock[]   @relation("Blocker")
  blocksReceived  UserBlock[]   @relation("Blocked")
}

model Device {
  id          String          @id @default(cuid())
  userId      String
  platform    DevicePlatform
  tokenType   DeviceTokenType
  pushToken   String
  enabled     Boolean         @default(true)
  lastSeenAt  DateTime        @default(now())
  invalidatedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  CallDelivery[]

  @@unique([userId, pushToken])
  @@index([userId, enabled])
}

model CallSession {
  id            String          @id @default(cuid())
  callerId      String
  calleeId      String
  type          CallType
  status        CallStatus      @default(CREATED)
  createdAt     DateTime        @default(now())
  ringingAt     DateTime?
  answeredAt    DateTime?
  endedAt       DateTime?
  durationSec   Int?
  endReason     String?
  expiresAt     DateTime
  caller        User            @relation("Caller", fields: [callerId], references: [id])
  callee        User            @relation("Callee", fields: [calleeId], references: [id])
  deliveries    CallDelivery[]
  events        CallEvent[]

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status, expiresAt])
}

model CallDelivery {
  id            String          @id @default(cuid())
  callId        String
  deviceId      String
  status        DeliveryStatus  @default(PENDING)
  providerId    String?
  errorCode     String?
  errorMessage  String?
  attemptedAt   DateTime        @default(now())
  deliveredAt   DateTime?
  call          CallSession     @relation(fields: [callId], references: [id], onDelete: Cascade)
  device        Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([callId, deviceId])
}

model CallEvent {
  id        String      @id @default(cuid())
  callId    String
  type      String
  actorId   String?
  payload   Json?
  createdAt DateTime    @default(now())
  call      CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
