NODE_ENV=production
API_DOMAIN=api.datebuk.example
TURN_DOMAIN=turn.datebuk.example
WEB_ORIGIN=https://datebuk.example
DATABASE_URL=postgresql://datebuk:CHANGE_ME@postgres:5432/datebuk?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=GENERATE_ME
COOKIE_SECRET=GENERATE_ME
APNS_KEY_PATH=/run/secrets/apple_apns_key
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.datebuk.app
APNS_PRODUCTION=true
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_service_account
TURN_HOST=turn.datebuk.example
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SHARED_SECRET=GENERATE_ME
TURN_CREDENTIAL_TTL_SECONDS=600
ANDROID_KEYSTORE_PATH=/run/secrets/android_release_keystore
ANDROID_KEYSTORE_PASSWORD=SUPPLY_SECURELY
ANDROID_KEY_ALIAS=datebuk
ANDROID_KEY_PASSWORD=SUPPLY_SECURELY
