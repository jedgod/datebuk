{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3000 node server.js",
    "dev:portal": "cross-env NODE_ENV=development PORT=3010 NEXT_DIST_DIR=.next-portal node server.js",
    "dev:admin": "pnpm run dev:portal",
    "dev:staff": "pnpm run dev:portal",
    "dev:both": "concurrently \"pnpm run dev\" \"pnpm run dev:admin\"",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:portal\"",
    "build": "next build",
    "start": "cross-env NODE_ENV=production PORT=3000 node server.js",
    "start:portal": "cross-env NODE_ENV=production PORT=3010 node server.js",
    "start:admin": "pnpm run start:portal",
    "start:staff": "pnpm run start:portal",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@shared/types": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.30",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.395.0",
    "next": "16.1.6",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.2.4",
    "react-infinite-scroll-component": "^6.1.1",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.13.0",
    "react-use-websocket": "^4.13.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.7.5",
    "stripe": "^15.12.0",
    "tailwind-merge": "^2.3.0",
    "ws": "^8.16.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
