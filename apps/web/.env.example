# Web App Security Configuration
# Copy this to .env.local in apps/web/

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4001
NEXT_PUBLIC_SUPPORT_PLATFORM_API_URL=http://localhost:4500
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3010

# Required server-only secrets (generate unique random values of at least 32 characters)
JWT_SECRET=
HASH_SALT=

# Optional: Enable debug logging
NEXT_PUBLIC_DEBUG_SECURITY=false

# Stripe billing (subscription checkout + webhook that actually grants the paid tier)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_PRICE_IDS=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=
NEXT_PUBLIC_STRIPE_PRICE_ELITE=
