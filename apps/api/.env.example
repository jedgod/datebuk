DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datepage?schema=public
API_URL=http://localhost:4000
SIGNALING_URL=http://localhost:4001
# Shared secret apps/api sends to apps/signaling's internal-only /internal/active-rooms
# endpoint (staff call-quality telemetry). Same variable name/value in both apps' .env.
SIGNALING_INTERNAL_KEY=change-me-super-secret
SUPPORT_PLATFORM_API_URL=http://localhost:4500
JWT_SECRET=
REFRESH_TOKEN_PEPPER=
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Symmetric key (>=32 chars) used to encrypt staff TOTP secrets at rest (AES-256-GCM).
# Required in production. Rotating this key invalidates all enrolled TOTP secrets
# (staff must re-enroll 2FA) since they can no longer be decrypted.
TOTP_ENCRYPTION_KEY=change-me-super-secret-32-chars-min

# Security & Risk Assessment
# IP Intelligence Service - get key from: https://ipapi.is/
IP_API_KEY=your_ipapi_key_here
# Machine Learning Service (optional)
ML_ENDPOINT=http://localhost:5000/predict
SHADOW_MODE=false
# Risk Thresholds
RISK_THRESHOLD_BLOCK=80
RISK_THRESHOLD_SMS=40
# Admin IPs for security features (comma-separated)
ADMIN_IPS=127.0.0.1

# Email (optional): if not set, emails are logged to console
EMAIL_FROM=DatePage <no-reply@datepage.app>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# S3 uploads (optional): if not set, server returns a helpful error for signed-url
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# ClamAV (optional, recommended)
CLAMD_HOST=localhost
CLAMD_PORT=3310

# Refresh token HMAC pepper (required in prod)
REFRESH_TOKEN_PEPPER=change-me-super-secret

# Admin accounts: set isAdmin=true in DB (seed makes demo admin)

# Broadcast throttling
BROADCAST_CHUNK_SIZE=250
BROADCAST_CHUNK_DELAY_MS=250

# Observability
LOG_LEVEL=info
PROM_METRICS_ENABLED=true
