model StaffActivityLog {
  id          String   @id @default(uuid())
  staffId     String
  action      String   // "login", "otp_failure", "task_completed", "user_banned", "data_export"
  target      String?  // What was affected (user ID, task ID, etc)
  ip          String?
  userAgent   String?
  details     Json?    // Additional context
  createdAt   DateTime @default(now())

  actor       User     @relation("StaffActor", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([action])
  @@index([createdAt])
}

model SessionToken {
  id                String   @id @default(uuid())
  userId            String
  refreshTokenHash  String   @unique
  accessTokenHash   String?
  
  isValid           Boolean  @default(true)
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  
  ip                String?
  userAgent         String?
  
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isValid])
  @@index([expiresAt])
}

// Video Session & Moderation Models
model VideoSession {
  id                String   @id @default(uuid())
  matchId           String
  startedAt         DateTime
  endedAt           DateTime?
  durationSeconds   Int      @default(0)
  status            ModerationStatusEnum @default(PENDING)
  aiScores          Json?    // { nudity, explicit_audio, overall }
  reportsCount      Int      @default(0)
  interruptedAt     DateTime?
  interruptionReason String?
  reviewedAt        DateTime?
  escalatedAt       DateTime?
  priority          String?  // "high", "normal", "low"
  lastMessageSnippet String?
  users             String[] // JSON array of user IDs participating
  createdAt         DateTime @default(now())

  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reports           Report[]
  flags             Flag[]
  moderationLogs    ModerationLog[]

  @@index([matchId])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedAt])
  @@index([escalatedAt])
}

model Report {
  id                String   @id @default(uuid())
  reporterId        String
  reportedId        String
  sessionId         String?
  matchId           String?
  reason            ViolationTypeEnum
  details           String?
  reportedAt        DateTime @default(now())
  handledAt         DateTime?
  outcome           String?  // APPROVED, REJECTED, FURTHER_REVIEW — legacy video-moderation field, unused by the general report flow below
  createdAt         DateTime @default(now())

  // General user-safety report flow (block/report on matches, messages, calls).
  status            ReportStatus   @default(OPEN)
  severity          ReportSeverity @default(LOW)
  // Snapshot of the recent conversation at report time, independent of the live
  // Message table, so evidence survives even if messages are later edited/deleted.
  conversationSnapshot Json?
  alsoBlocked       Boolean  @default(false)
  resolvedBy        String?
  resolvedAt        DateTime?
  resolutionNote    String?

  // Restrict, not Cascade: reports are trust-and-safety evidence that must
  // survive deletion of either party's account (e.g. a banned/deleted
  // offender's report history), not disappear with it.
  reporter          User     @relation("ReportedByUser", fields: [reporterId], references: [id], onDelete: Restrict)
  reported          User     @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Restrict)
  session           VideoSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  match             Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedId])
  @@index([sessionId])
  @@index([reason])
  @@index([createdAt])
  @@index([status])
  @@index([severity])
}

model Block {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  reason     String?
  createdAt  DateTime @default(now())

  blocker    User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Flag {
  id                String   @id @default(uuid())
  userId            String
  sessionId         String?
  type              ViolationTypeEnum
  aiScore           Float    @default(0)
  flaggedAt         DateTime @default(now())
  resolved          Boolean  @default(false)
  resolution        String?  // APPROVED, REJECTED, CAUTION
  createdAt         DateTime @default(now())

  // Restrict, not Cascade: flags are moderation evidence and must survive
  // deletion of the flagged user's account.
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  session           VideoSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([resolved])
  @@index([createdAt])
}

model ModerationLog {
  id                String   @id @default(uuid())
  userId            String
  sessionId         String?
  action            String   // "reviewed", "approved", "rejected", "escalated", "user_warned"
  reason            String?
  adminNotes        String?
  decisionDetails   Json?
  createdAt         DateTime @default(now())

  // Restrict, not Cascade: moderation history is an audit trail and must
  // survive deletion of the moderated user's account.
  user              User     @relation("ModerationLogs", fields: [userId], references: [id], onDelete: Restrict)
  session           VideoSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String
  tier              SubscriptionTierEnum
  status            String   @default("active") // active, canceled, expired
  currentPeriodStart DateTime
  currentPeriodEnd  DateTime
  canceledAt        DateTime?
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tier])
  @@index([status])
  @@index([currentPeriodEnd])
}

model QuarantinedVideo {
  id                String   @id @default(uuid())
  videoId           String
  userId            String
  severity          Int      @default(0)
  priority          String   @default("P3") // P0-P5 priority levels
  nudityScore       Int      @default(0)
  audioScore        Int      @default(0)
  reason            String?
  chatContext       String?
  keyframeUrls      String[] // JSON array of S3 URLs
  waveformUrl       String?
  waveformPeaks     Int[]    @default([]) // JSON array of audio peak data
  durationSeconds   Int      @default(0)
  status            String   @default("quarantined") // quarantined, released, deleted, escalated
  moderatorNotes    String?
  reviewedBy        String?
  reviewedAt        DateTime?
  deletedBy         String?
  deletedAt         DateTime?
  deletionReason    String?
  escalatedBy       String?
  escalatedAt       DateTime?
  escalationReason  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Restrict, not Cascade: quarantined-content records are moderation/legal
  // evidence and must survive deletion of the uploader's account.
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([createdAt])
}

model FilterPreset {
  id                String   @id @default(uuid())
  userId            String
  name              String
  filters           Json     // Store filter configuration as JSON
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

// Backs apps/web's /api/admin/video-date/settings route, which previously
// held every settings category (followup, icebreaker, safety, location,
// reflection, readiness, subscription, system) in an in-memory object with
// an explicit "TODO: Implement database save" — GET always returned the
// same hardcoded defaults and POST silently discarded whatever was saved.
// One row per settings category, value shape is category-specific (hence
// Json) — see VIDEO_DATE_SETTINGS_TYPES in the route for the valid `type`
// values.
model VideoDateSetting {
  type      String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}


// ID document + selfie verification. Raw images are processed in memory and never stored;
// only the non-sensitive outcome is kept here.
model IdentityVerification {
  id               String   @id @default(uuid())
  userId           String
  channel          String   // SMS_WEB (texted link, opened on the phone) | MOBILE_APP (in-app)
  // PENDING_CAPTURE -> PROCESSING -> APPROVED | REJECTED | EXPIRED
  status           String   @default("PENDING_CAPTURE")
  // SHA-256 of the one-time capture token embedded in the texted link; the raw token is never stored.
  tokenHash        String   @unique
  tokenExpiresAt   DateTime
  phoneLast4       String?
  // Liveness challenge the selfie must satisfy: LOOK_LEFT | LOOK_RIGHT
  challenge        String
  attempts         Int      @default(0)
  consentedAt      DateTime
  // Outcome details (no document number, no raw name/DOB stored)
  docType          String?
  docExpired       Boolean?
  ageOk            Boolean?
  dobMatches       Boolean?
  nameMatches      Boolean?
  faceSimilarity   Float?
  livenessPassed   Boolean?
  decisionReason   String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}


// ---- Subscription feature access (ported from the DSACS reference pack) ----------------
// Daily per-feature usage counters (UTC day). The plan itself is NOT stored here: it is
// derived from UserSubscription/User.subscriptionTier by SubscriptionsService.getAccessTier.
model FeatureUsage {
  userId  String
  feature String
  day     DateTime @db.Date
  count   Int

  @@id([userId, feature, day])
  @@index([day])
}

// Idempotency ledger: replaying the same requestId returns the stored result and never
// consumes quota twice; reusing a requestId with a different payload is rejected.
model FeatureOperation {
  userId      String
  requestId   String
  feature     String
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())

  @@id([userId, requestId])
}

// Admin kill switch: a listed feature is denied for everyone (safety features excepted).
model DisabledFeature {
  feature    String   @id
  disabledBy String?
  createdAt  DateTime @default(now())
}

// ---- SMS provider (ported from the DCG reference pack, single DateBuk account) ---------
model TwilioAccount {
  id                 String   @id @default(uuid())
  name               String
  accountSid         String   @unique
  // pending -> verified -> active; active <-> rotating (during credential swap);
  // suspended (manual or automatic on auth failure); revoked is terminal.
  // At most ONE account is active at a time (partial unique index), so a suspended or failing
  // account is never silently replaced by another one.
  status             String   @default("pending")
  statusReason       String?
  // Credentials, AES-256-GCM via the DCG credential vault (versioned). The Auth Token is also
  // what Twilio signs webhooks with, so webhooks can't be verified for API-key-only accounts.
  encryptedAuthToken String?
  apiKeySid          String?
  encryptedApiKeySecret String?
  keyVersion         Int      @default(0)   // 0 = legacy (encrypted with TOTP_ENCRYPTION_KEY)
  lastValidatedAt    DateTime?
  rotatedAt          DateTime?
  // Spending controls (SMS segments). null = no cap.
  dailySegmentLimit   Int?
  monthlySegmentLimit Int?
  // Destination restriction: E.164 prefixes messages may be sent to, e.g. {"+1"}.
  allowedPrefixes    String[] @default(["+1"])
  createdBy          String?
  createdAt          DateTime @default(now())
  senders            TwilioSender[]
}

model TwilioSender {
  id                  String   @id @default(uuid())
  accountId           String
  senderNumber        String?  // E.164 number owned by the account
  messagingServiceSid String?  // MG... service owned by the account (exactly one of the two)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  account             TwilioAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// Numbers that replied STOP; no message is sent to them until they reply START.
model SmsSuppression {
  phone     String   @id
  createdAt DateTime @default(now())
}

model SmsMessage {
  id             String   @id @default(uuid())
  accountId      String?
  segments       Int      @default(1)
  userId         String?
  purpose        String
  // Business reference the message belongs to (e.g. the IdentityVerification id). Lets the
  // dispatcher re-check, right before sending, that the message is still wanted.
  ref            String?
  recipientLast4 String
  providerSid    String?  @unique
  // queued -> dispatching -> accepted -> sending -> sent -> delivered | undelivered | failed
  // dispatching -> uncertain (ambiguous result; NEVER retried, resolved by a signed webhook or an admin)
  // see sms/sms-state.ts for the full transition table
  state          String   @default("queued")
  // Outbox payload: AES-256-GCM via the credential vault, bound to this row. Erased the moment
  // the message leaves queued/dispatching, so nothing readable is retained after dispatch.
  toEncrypted    String?
  bodyEncrypted  String?
  // Caller-supplied; the same key can only ever create one message.
  idempotencyKey String?  @unique
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  leaseUntil     DateTime?
  claimedBy      String?
  lastError      String?
  // After this the message is cancelled rather than sent late (e.g. a 30-minute verification link).
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([accountId, createdAt])
  @@index([state, nextAttemptAt])
}

// One row per distinct provider callback (account + message + status). A replay hits the unique
// key and is acknowledged without being applied twice.
model SmsWebhookEvent {
  eventKey    String   @id
  accountSid  String
  providerSid String
  status      String
  receivedAt  DateTime @default(now())

  @@index([providerSid])
}
