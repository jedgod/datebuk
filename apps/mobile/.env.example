# Mobile App Security Configuration
# Copy this to .env in apps/mobile/

# API Configuration
# Update this to match your backend URL (Nest API)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Signaling server URL for WebRTC call events
# Use LAN IP on physical devices, e.g. http://192.168.1.50:4001
EXPO_PUBLIC_SIGNALING_URL=http://localhost:4001

# Optional TURN server for production call reliability
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# Web app origin — the mobile upgrade flow opens the same Stripe Checkout
# session the web dashboard uses (via apps/web's /api/stripe/checkout route)
# in an in-app browser, rather than duplicating payment integration natively.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Same Stripe Price IDs as apps/web's NEXT_PUBLIC_STRIPE_PRICE_PREMIUM/ELITE.
EXPO_PUBLIC_STRIPE_PRICE_PREMIUM=
EXPO_PUBLIC_STRIPE_PRICE_ELITE=

# Optional: Security debugging
EXPO_PUBLIC_DEBUG_SECURITY=false

# Optional: Biometric auth settings
EXPO_PUBLIC_ENABLE_BIOMETRIC=true

# Optional: Risk assessment sensitivity
# Controls how strict the risk thresholds are
# Values: strict, normal, relaxed
EXPO_PUBLIC_RISK_SENSITIVITY=normal
