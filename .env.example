WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
SIGNALING_URL=http://localhost:4001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010
TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-coturn-use-auth-secret

# apps/api
DATABASE_URL=postgresql://postgres:Etikese1986@localhost:5432/datepage?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

REDIS_URL=redis://localhost:6379

# --- ID + selfie verification (registration) ---------------------------------
# SMS link sent to the user's phone (Twilio). Set the SID + token, and EITHER a
# Messaging Service SID (preferred) OR a sender number in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# OCR (Textract) + face match/liveness (Rekognition). Region + credentials, or an IAM role.
# IDENTITY_PROVIDER=aws   # aws (required in production) | mock (local dev, no real checks)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Minimum Rekognition similarity (0-100) between selfie and ID photo to accept. Default 90.
# IDENTITY_FACE_THRESHOLD=90
# Reject when the account's full name doesn't match the ID. Default false.
# IDENTITY_REQUIRE_NAME_MATCH=false

# --- Twilio via the admin API (preferred over the env vars above) ------------------------
# An admin registers the Account SID + Auth Token and a sender (number or Messaging Service)
# with POST /api/admin/sms/accounts and /api/admin/sms/senders. The token is validated against
# Twilio and stored AES-256-GCM encrypted (key: TOTP_ENCRYPTION_KEY). The env vars above are
# only a fallback. In Twilio, point status + inbound webhooks at:
#   <public API origin>/api/sms/webhooks/status   and   <public API origin>/api/sms/webhooks/inbound
# SMS_WEBHOOK_BASE_URL=https://api.example.com   # defaults to API_URL; must be the public https origin

# --- Communications (DCG): credential vault + controls -----------------------------------
# Dedicated key for Twilio credentials. MUST differ from TOTP_ENCRYPTION_KEY. Generate with:
#   openssl rand -base64 32
# To rotate: set DCG_ENCRYPTION_KEY to the new key, bump DCG_ENCRYPTION_KEY_VERSION, keep the old
# key as DCG_ENCRYPTION_KEY_V<oldVersion>, run POST /api/admin/sms/credentials/migrate, then
# remove the old key once `remainingKeyVersions` shows only the new version.
DCG_ENCRYPTION_KEY=
DCG_ENCRYPTION_KEY_VERSION=1
# Module switches (all default false/true as shown; production must keep SIGNATURE_REQUIRED=true)
DCG_ENABLED=false
DCG_LIVE_SMS_ENABLED=false
DCG_ENV_FALLBACK_ENABLED=false
DCG_WEBHOOK_SIGNATURE_REQUIRED=true
# Optional environment-credential fallback (only used when DCG_ENV_FALLBACK_ENABLED=true)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
